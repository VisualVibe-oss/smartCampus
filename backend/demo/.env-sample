# SmartCampus - Variables d'environnement (exemple)
# Copier vers .env et adapter les valeurs

# --- PostgreSQL ---
POSTGRES_DB=smartcampus
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# --- Application Spring Boot ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smartcampus
SPRING_DATASOURCE_USERNAME=smartcampus
SPRING_DATASOURCE_PASSWORD=change_me
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
